# Token de longa duração do Instagram Login para uma conta profissional (Empresa/Criador).
# Não coloque o token neste arquivo no repositório; configure-o no painel da Vercel.
INSTAGRAM_ACCESS_TOKEN=

# A integração usa a versão atual da API por padrão; sobrescreva somente se necessário.
INSTAGRAM_API_VERSION=v26.0

# Opcional: sobrescreve a URL pública da planilha usada pelo endpoint da Agenda.
# Se vazio, a API usa a URL publicada oficial definida como padrão em api/agenda.ts.
AGENDA_CSV_URL=
